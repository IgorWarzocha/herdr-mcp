# Linux/WSL systemd example. Copy to ~/.config/herdr-mcp/service.env and edit paths.
# macOS: use launchd/dev.herdr-mcp.plist instead. Native Windows: use environment vars.
# Put Herdr TUI 0.9.5+, Core hc 0.1.14+, or both on PATH; stale binaries block startup.
# Use ABSOLUTE paths only: systemd does not expand %h, ~ or $HOME in EnvironmentFile,
# and SETUP.md sources this file in a shell. Replace /home/YOU; quote paths with spaces.
PATH=/home/YOU/.local/bin:/usr/local/bin:/usr/bin:/bin
# HERDR_MCP_BINARY=herdr                              # name on PATH or absolute path
# HERDR_MCP_SOCKET=/home/YOU/.config/herdr/herdr.sock     # Herdr API socket (pinned session)
# HERDR_MCP_CORE_BINARY=hc                          # name on PATH or absolute path; required when set
# HERDR_MCP_CORE_SOCKET=/absolute/path/core.sock      # optional private Core socket
# HERDR_MCP_CORE_SESSION=default                     # pinned local Core session
# HERDR_MCP_TOKEN_FILE=/home/YOU/.config/herdr-mcp/token  # 64 hex chars, mode 0600
# HERDR_MCP_HOST=127.0.0.1                            # keep loopback; expose via Funnel/Tunnel
PORT=8792
# HERDR_MCP_WAIT_MAX=90000                           # wait / pane wait-output ceiling in ms (90 s)
# HERDR_MCP_ORIGINS=                                  # comma list of browser Origins; server clients need none
# Optional OAuth alongside the existing bearer token. See docs/oauth.md.
# HERDR_MCP_PUBLIC_URL=https://your-host.example/herdr-mcp
# HERDR_MCP_OAUTH_CLIENT_ID=herdr-chatgpt
# HERDR_MCP_OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
# HERDR_MCP_OAUTH_STATE_FILE=/home/YOU/.config/herdr-mcp/oauth.json
# HERDR_MCP_PROTOCOL_LOG=1                            # temporary method/version-only client diagnostics
