# All optional; defaults shown. Copy to ~/.config/herdr-mcp/service.env for systemd.
# Put the directory with Herdr 0.9+ FIRST (an old /usr/bin/herdr can shadow ~/.local/bin).
# Use ABSOLUTE paths only: systemd does not expand %h, ~ or $HOME in EnvironmentFile,
# and AGENTS.md sources this file in a shell. Replace /home/YOU.
PATH=/home/YOU/.local/bin:/usr/local/bin:/usr/bin:/bin
# HERDR_MCP_BINARY=herdr                              # name on PATH or absolute path
# HERDR_MCP_SOCKET=/home/YOU/.config/herdr/herdr.sock     # Herdr API socket (pinned session)
# HERDR_MCP_TOKEN_FILE=/home/YOU/.config/herdr-mcp/token  # 64 hex chars, mode 0600
# HERDR_MCP_HOST=127.0.0.1                            # keep loopback; expose via Funnel/Tunnel
PORT=8792
# HERDR_MCP_ORIGINS=                                  # comma list of browser Origins; server clients need none
