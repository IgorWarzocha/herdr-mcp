<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.herdr-mcp</string>
  <!-- Replace /Users/YOU and the Node/Herdr binary directories before loading. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/YOU/herdr-mcp/bin/herdr-mcp.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/YOU/herdr-mcp</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/YOU/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HERDR_MCP_TOKEN_FILE</key>
    <string>/Users/YOU/.config/herdr-mcp/token</string>
    <key>HERDR_MCP_SOCKET</key>
    <string>/Users/YOU/.config/herdr/herdr.sock</string>
    <key>PORT</key>
    <string>8792</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>3</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/herdr-mcp.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/herdr-mcp.log</string>
</dict>
</plist>
